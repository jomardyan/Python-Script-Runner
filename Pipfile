[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Core Dependencies - Production
psutil = ">=5.9.0,<6.0"
pyyaml = ">=6.0,<7.0"
requests = ">=2.33.0,<3.0"

# Optional: Advanced Features
# Install with: pipenv install --categories="packages,export"
[export]
pyarrow = ">=23.0.1"
scikit-learn = ">=1.3,<2.0"

# Dashboard (Optional)
# Install with: pipenv install --categories="packages,dashboard"
[dashboard]
fastapi = ">=0.132.0"
uvicorn = {version = ">=0.24.0,<1.0", extras = ["standard"]}
python-multipart = ">=0.0.31"
websockets = ">=12.0"

[dev-packages]
# Testing
pytest = ">=7.0.0,<8.0"
pytest-cov = ">=4.0.0,<5.0"

# Code Quality
black = ">=26.1.0"
flake8 = ">=7.0.0"
mypy = ">=0.900,<2.0"

# Documentation
mkdocs = ">=1.4.0,<2.0"
mkdocs-material = ">=9.0.0,<10.0"

[requires]
# Maintained development/update-bot interpreter; package runtime metadata is unchanged.
python_version = "3.11"
